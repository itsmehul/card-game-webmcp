{
  "id": "gin-rummy",
  "name": "Gin Rummy",
  "summary": "Build melds of sets and runs, draw from stock or discard, and knock to catch your opponent.",
  "botCount": 1,
  "jokers": false,
  "chips": false,
  "turnDirection": "clockwise",
  "enabledZones": {
    "stock": true,
    "hand": true,
    "play": false,
    "discard": true,
    "capture": true
  },
  "instructions": "Draw from stock, then discard one card to end your turn. Knock when ready for showdown. The bot draws and discards automatically after you.",
  "openingNarration": "Gin Rummy ready. Deal 10 cards each and form your melds.",
  "machine": {
    "id": "gin-rummy",
    "initial": "waiting_to_deal",
    "states": {
      "waiting_to_deal": {
        "meta": {
          "controls": [
            {
              "id": "deal",
              "label": "Deal hands",
              "event": "DEAL",
              "primitive": "deal_spec"
            }
          ]
        },
        "on": {
          "DEAL": {
            "target": "need_draw",
            "actions": [
              {
                "type": "dealSpec",
                "params": {
                  "dealSpec": [
                    { "target": "each", "count": 10, "visibility": "hidden" }
                  ]
                }
              },
              "dealStarterDiscard",
              {
                "type": "narrate",
                "params": {
                  "text": "10 cards each. Draw from stock, then discard."
                }
              },
              { "type": "setTurn", "params": { "playerId": "human" } }
            ]
          }
        }
      },
      "need_draw": {
        "meta": {
          "controls": [
            {
              "id": "draw_stock",
              "label": "Draw from stock",
              "event": "DRAW",
              "primitive": "draw",
              "count": 1
            },
            {
              "id": "knock",
              "label": "Knock",
              "event": "KNOCK",
              "primitive": "pass"
            }
          ]
        },
        "on": {
          "DRAW": {
            "target": "need_discard",
            "actions": [
              {
                "type": "drawHuman",
                "params": { "count": 1, "visibility": "hidden" }
              },
              {
                "type": "narrate",
                "params": { "text": "Drew. Now discard a card." }
              }
            ]
          },
          "KNOCK": {
            "target": "showdown",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "You knocked! Hand over." }
              }
            ]
          }
        }
      },
      "need_discard": {
        "meta": {
          "controls": [
            {
              "id": "discard_card",
              "label": "Discard card",
              "event": "DISCARD",
              "primitive": "discard",
              "requiresCardSelection": true
            }
          ]
        },
        "on": {
          "DISCARD": {
            "target": "bots_play",
            "actions": [
              "discardHuman",
              "rotateTurn",
              {
                "type": "narrate",
                "params": { "text": "You discarded. Bot's turn…" }
              }
            ]
          }
        }
      },
      "bots_play": {
        "entry": ["botSimplePlayOrDraw"],
        "always": [
          {
            "guard": { "type": "isHumanTurn" },
            "target": "need_draw",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "Your turn — draw or knock." }
              }
            ]
          },
          { "target": "need_draw" }
        ]
      },
      "showdown": {
        "type": "final",
        "meta": { "controls": [] }
      }
    }
  }
}
