{
  "id": "war",
  "name": "War",
  "summary": "Both sides flip at once; the higher card sweeps the pile into a capture stack.",
  "botCount": 1,
  "jokers": false,
  "chips": false,
  "turnDirection": "clockwise",
  "enabledZones": {
    "stock": true,
    "hand": true,
    "play": true,
    "discard": false,
    "capture": true
  },
  "instructions": "The deck splits evenly. Flip turns one card from every hand face up. The higher card automatically takes the pile; on a tie, click War to add two more cards each, then Award the battle.",
  "openingNarration": "War ready. Split the deck, then flip.",
  "machine": {
    "id": "war",
    "initial": "waiting_to_deal",
    "states": {
      "waiting_to_deal": {
        "meta": {
          "controls": [
            {
              "id": "deal",
              "label": "Split the deck",
              "event": "DEAL",
              "primitive": "deal_all",
              "count": 26
            }
          ]
        },
        "on": {
          "DEAL": {
            "target": "ready_to_flip",
            "actions": [
              {
                "type": "dealAll",
                "params": { "count": 26, "visibility": "hidden" }
              },
              {
                "type": "narrate",
                "params": { "text": "Deck split 26 each. Flip to start." }
              }
            ]
          }
        }
      },
      "ready_to_flip": {
        "meta": {
          "controls": [
            {
              "id": "flip",
              "label": "Flip",
              "event": "FLIP",
              "primitive": "play_all",
              "count": 1
            }
          ]
        },
        "on": {
          "FLIP": {
            "target": "after_flip",
            "actions": [
              {
                "type": "playAll",
                "params": { "count": 1, "visibility": "public" }
              }
            ]
          }
        }
      },
      "after_flip": {
        "always": [
          {
            "guard": { "type": "playEmpty" },
            "target": "out_of_cards",
            "actions": [
              {
                "type": "narrate",
                "params": {
                  "text": "No cards left to flip. Count the capture piles."
                }
              }
            ]
          },
          {
            "guard": { "type": "warHasWinner" },
            "target": "ready_to_flip",
            "actions": [
              "resolveWarIfDecisive",
              {
                "type": "narrate",
                "params": { "text": "Higher card takes the pile. Flip again." }
              }
            ]
          },
          {
            "target": "war_tie",
            "actions": [
              {
                "type": "narrate",
                "params": {
                  "text": "Tie! Click War to add two cards each, then Award the battle."
                }
              }
            ]
          }
        ]
      },
      "war_tie": {
        "meta": {
          "controls": [
            {
              "id": "war",
              "label": "War (tie)",
              "event": "WAR",
              "primitive": "play_all",
              "count": 2
            },
            {
              "id": "resolve",
              "label": "Award the battle",
              "event": "RESOLVE",
              "primitive": "sweep"
            }
          ]
        },
        "on": {
          "WAR": {
            "target": "war_tie",
            "actions": [
              {
                "type": "playAll",
                "params": { "count": 2, "visibility": "public" }
              },
              {
                "type": "narrate",
                "params": {
                  "text": "War — two more cards each. Award when ready."
                }
              }
            ]
          },
          "RESOLVE": [
            {
              "guard": { "type": "warHasWinner" },
              "target": "ready_to_flip",
              "actions": [
                "sweepPlayToWinner",
                {
                  "type": "narrate",
                  "params": { "text": "Battle awarded. Flip again." }
                }
              ]
            },
            {
              "target": "war_tie",
              "actions": [
                {
                  "type": "narrate",
                  "params": { "text": "Still tied — War again." }
                }
              ]
            }
          ]
        }
      },
      "out_of_cards": {
        "type": "final",
        "meta": { "controls": [] }
      }
    }
  }
}
