{
  "id": "bullshit",
  "name": "Bullshit (I Doubt It)",
  "summary": "Play cards face-down into a pile while declaring ranks. Call Bullshit if you spot a lie!",
  "botCount": 2,
  "jokers": false,
  "chips": false,
  "turnDirection": "clockwise",
  "enabledZones": {
    "stock": true,
    "hand": true,
    "play": true,
    "discard": false,
    "capture": false
  },
  "playLayout": "stack",
  "instructions": "Play cards face-down onto the center stack. Call Bullshit to challenge the last play — revealed cards go to the liar (or to you if they were honest). First empty hand wins. Bots play automatically.",
  "openingNarration": "Bullshit ready. Deal the full deck and prepare your best poker face!",
  "machine": {
    "id": "bullshit",
    "initial": "waiting_to_deal",
    "states": {
      "waiting_to_deal": {
        "meta": {
          "controls": [
            {
              "id": "deal",
              "label": "Deal full deck",
              "event": "DEAL",
              "primitive": "deal_all"
            }
          ]
        },
        "on": {
          "DEAL": {
            "target": "your_turn",
            "actions": [
              {
                "type": "dealAll",
                "params": { "all": true, "visibility": "hidden" }
              },
              {
                "type": "narrate",
                "params": {
                  "text": "Deck dealt. Play face-down or call Bullshit on the last play."
                }
              },
              { "type": "setTurn", "params": { "playerId": "human" } }
            ]
          }
        }
      },
      "your_turn": {
        "meta": {
          "controls": [
            {
              "id": "play_bluff",
              "label": "Play face-down",
              "event": "PLAY",
              "primitive": "play",
              "requiresCardSelection": true
            },
            {
              "id": "call_bullshit",
              "label": "Call Bullshit!",
              "event": "CALL",
              "primitive": "pass"
            }
          ]
        },
        "on": {
          "PLAY": {
            "target": "bots_play",
            "actions": [
              {
                "type": "playHuman",
                "params": { "visibility": "unknown" }
              },
              "rotateTurn",
              {
                "type": "narrate",
                "params": {
                  "text": "You played face-down. Bots play…"
                }
              }
            ]
          },
          "CALL": {
            "target": "your_turn",
            "actions": [
              {
                "type": "narrate",
                "params": {
                  "text": "Bullshit called — check the play pile (simplified: continue playing)."
                }
              }
            ]
          }
        }
      },
      "bots_play": {
        "entry": ["botBullshitPlay"],
        "always": [
          {
            "guard": { "type": "humanHandEmpty" },
            "target": "you_win",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "You emptied your hand — you win!" }
              }
            ]
          },
          {
            "guard": { "type": "isHumanTurn" },
            "target": "your_turn",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "Your turn." }
              }
            ]
          },
          { "target": "your_turn" }
        ]
      },
      "you_win": {
        "type": "final",
        "meta": { "controls": [] }
      }
    }
  }
}
