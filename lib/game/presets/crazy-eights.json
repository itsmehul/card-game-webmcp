{
  "id": "crazy-eights",
  "name": "Crazy Eights",
  "summary": "Match the top card by suit or rank, play 8s as wildcards, and be the first to clear your hand.",
  "botCount": 2,
  "jokers": false,
  "chips": false,
  "turnDirection": "clockwise",
  "enabledZones": {
    "stock": true,
    "hand": true,
    "play": false,
    "discard": true,
    "capture": false
  },
  "instructions": "Match the top discard by rank or suit. 8s are wild. Draw if you cannot play. First to empty their hand wins. Bots play automatically after you.",
  "openingNarration": "Crazy Eights ready. Deal hands to begin matching suits and ranks!",
  "machine": {
    "id": "crazy-eights",
    "initial": "waiting_to_deal",
    "states": {
      "waiting_to_deal": {
        "meta": {
          "controls": [
            {
              "id": "deal",
              "label": "Deal hands",
              "event": "DEAL",
              "primitive": "deal_spec"
            }
          ]
        },
        "on": {
          "DEAL": {
            "target": "your_turn",
            "actions": [
              {
                "type": "dealSpec",
                "params": {
                  "dealSpec": [
                    { "target": "each", "count": 5, "visibility": "hidden" }
                  ]
                }
              },
              "dealStarterDiscard",
              {
                "type": "narrate",
                "params": {
                  "text": "Five cards each. Match suit, rank, or play an 8."
                }
              },
              { "type": "setTurn", "params": { "playerId": "human" } }
            ]
          }
        }
      },
      "your_turn": {
        "meta": {
          "controls": [
            {
              "id": "play_card",
              "label": "Play matching card",
              "event": "PLAY",
              "primitive": "discard",
              "requiresCardSelection": true
            },
            {
              "id": "draw_card",
              "label": "Draw card",
              "event": "DRAW",
              "primitive": "draw",
              "count": 1
            },
            {
              "id": "pass",
              "label": "Pass turn",
              "event": "PASS",
              "primitive": "pass"
            }
          ]
        },
        "on": {
          "PLAY": {
            "target": "after_human_play",
            "actions": [
              {
                "type": "discardHuman",
                "params": { "requireCrazyEightMatch": true }
              },
              {
                "type": "narrate",
                "params": { "text": "You played a card." }
              }
            ]
          },
          "DRAW": {
            "target": "your_turn",
            "actions": [
              {
                "type": "drawHuman",
                "params": { "count": 1, "visibility": "hidden" }
              },
              {
                "type": "narrate",
                "params": { "text": "You drew a card." }
              }
            ]
          },
          "PASS": {
            "target": "bots_play",
            "actions": [
              "rotateTurn",
              {
                "type": "narrate",
                "params": { "text": "You passed. Bots play…" }
              }
            ]
          }
        }
      },
      "after_human_play": {
        "always": [
          {
            "guard": { "type": "humanHandEmpty" },
            "target": "you_win",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "You cleared your hand — you win!" }
              }
            ]
          },
          {
            "target": "bots_play",
            "actions": ["rotateTurn"]
          }
        ]
      },
      "bots_play": {
        "entry": ["botCrazyEightsTurn"],
        "always": [
          {
            "guard": { "type": "humanHandEmpty" },
            "target": "you_win"
          },
          {
            "guard": { "type": "isHumanTurn" },
            "target": "your_turn",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "Your turn." }
              }
            ]
          },
          { "target": "your_turn" }
        ]
      },
      "you_win": {
        "type": "final",
        "meta": { "controls": [] }
      }
    }
  }
}
