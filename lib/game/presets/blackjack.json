{
  "id": "blackjack",
  "name": "Blackjack",
  "summary": "Hit or stand against the dealer, with live soft totals and automatic bust detection.",
  "botCount": 1,
  "jokers": false,
  "chips": true,
  "startingStack": 500,
  "turnDirection": "clockwise",
  "enabledZones": {
    "stock": true,
    "hand": true,
    "play": false,
    "discard": true,
    "capture": false
  },
  "instructions": "Beat the dealer without going over 21. Number cards = face value, face cards = 10, Aces = 1 or 11. The dealer hits until 17+. Settlement (even money, blackjack 3:2, push) is automatic.",
  "openingNarration": "Blackjack ready. Bet 10, then deal the cards.",
  "machine": {
    "id": "blackjack",
    "initial": "waiting_for_bet",
    "states": {
      "waiting_for_bet": {
        "meta": {
          "controls": [
            {
              "id": "bet",
              "label": "Bet 10",
              "event": "BET",
              "chipAction": "bet",
              "amount": 10,
              "primitive": "bet"
            }
          ]
        },
        "on": {
          "BET": {
            "target": "waiting_to_deal",
            "actions": [
              { "type": "chipBet", "params": { "amount": 10 } },
              { "type": "narrate", "params": { "text": "Bet placed. Deal the cards." } }
            ]
          }
        }
      },
      "waiting_to_deal": {
        "meta": {
          "controls": [
            {
              "id": "deal",
              "label": "Deal hands",
              "event": "DEAL",
              "primitive": "deal_spec"
            }
          ]
        },
        "on": {
          "DEAL": {
            "target": "player_act",
            "actions": [
              {
                "type": "dealSpec",
                "params": {
                  "dealSpec": [
                    { "target": "human", "count": 2, "visibility": "public" },
                    { "target": "bot_1", "count": 1, "visibility": "public" },
                    { "target": "bot_1", "count": 1, "visibility": "unknown" }
                  ]
                }
              },
              {
                "type": "narrate",
                "params": {
                  "text": "Hands dealt. The dealer shows one card. Hit or stand."
                }
              }
            ]
          }
        }
      },
      "player_act": {
        "meta": {
          "controls": [
            {
              "id": "hit",
              "label": "Hit",
              "event": "HIT",
              "primitive": "draw",
              "count": 1
            },
            {
              "id": "stand",
              "label": "Stand",
              "event": "STAND",
              "primitive": "pass"
            }
          ]
        },
        "on": {
          "HIT": {
            "target": "after_hit",
            "actions": [
              {
                "type": "drawHuman",
                "params": { "count": 1, "visibility": "public" }
              }
            ]
          },
          "STAND": {
            "target": "dealer_act",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "You stand. Dealer's turn." }
              },
              { "type": "setTurn", "params": { "playerId": "bot_1" } }
            ]
          }
        }
      },
      "after_hit": {
        "always": [
          {
            "guard": {
              "type": "handBusted",
              "params": { "aceAlt": 11, "bustOver": 21 }
            },
            "target": "bust",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "Bust! Your hand went over 21." }
              }
            ]
          },
          {
            "guard": {
              "type": "handScoreEq",
              "params": { "aceAlt": 11, "bustOver": 21, "value": 21 }
            },
            "target": "dealer_act",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "21. Dealer's turn." }
              },
              { "type": "setTurn", "params": { "playerId": "bot_1" } }
            ]
          },
          {
            "target": "player_act",
            "actions": [
              {
                "type": "narrate",
                "params": { "text": "You hit. Hit again or stand." }
              }
            ]
          }
        ]
      },
      "bust": {
        "entry": [
          { "type": "settleBlackjack", "params": { "reason": "bust" } }
        ],
        "always": [{ "target": "hand_over" }]
      },
      "dealer_act": {
        "entry": [
          "revealDealerHole",
          "dealerHitTo17",
          { "type": "settleBlackjack", "params": { "reason": "compare" } }
        ],
        "always": [{ "target": "hand_over" }]
      },
      "hand_over": {
        "meta": {
          "controls": [
            {
              "id": "new_hand",
              "label": "New hand",
              "event": "NEW_HAND",
              "primitive": "pass"
            }
          ]
        },
        "on": {
          "NEW_HAND": {
            "target": "waiting_for_bet",
            "actions": [
              "resetHand",
              {
                "type": "narrate",
                "params": { "text": "New hand. Bet 10 to play." }
              }
            ]
          }
        }
      }
    }
  }
}
